# Maintainer: Evelopment Games <https://discord.gg/AGfaBwNKfN>
# AUR package that installs the prebuilt Linux release from GitHub (no compiling).
pkgname=evelopment-games-designer-bin
_pkgname=evelopment-games-designer
pkgver=0.11.0
pkgrel=1
pkgdesc="All-in-one game design tool: writing, wiki, maps, boards, lists and calculators"
arch=('x86_64')
url="https://github.com/Evelynnsrepos/Evelopment-Games-Designer"
license=('GPL-3.0-only')
depends=('webkit2gtk-4.1' 'gtk3' 'hicolor-icon-theme')
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("$_pkgname-$pkgver.deb::$url/releases/download/v$pkgver/Evelopment.Games.Designer_${pkgver}_amd64.deb"
        "LICENSE-$pkgver::https://raw.githubusercontent.com/Evelynnsrepos/Evelopment-Games-Designer/v$pkgver/LICENSE")
noextract=("$_pkgname-$pkgver.deb")
sha256sums=('ad8a755fc49728c0716eefa1b2603fa7814fc1cd7d51e28057213976af4c2b16'
            '3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986')

package() {
  bsdtar -xOf "$_pkgname-$pkgver.deb" data.tar.gz | bsdtar -xf - -C "$pkgdir"
  # The .deb names the launcher after the app title; use the package name instead.
  mv "$pkgdir/usr/share/applications/Evelopment Games Designer.desktop" \
     "$pkgdir/usr/share/applications/$_pkgname.desktop"
  install -Dm644 "LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
